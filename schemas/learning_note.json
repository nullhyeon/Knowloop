{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningNote",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "learning_note_id",
    "student_id",
    "course_id",
    "class_id",
    "concepts",
    "gaps",
    "next_actions",
    "created_at"
  ],
  "properties": {
    "learning_note_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "class_id": {
      "type": "string"
    },
    "actor_role": {
      "type": "string",
      "enum": [
        "student",
        "system"
      ]
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flashcards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "front",
          "back"
        ],
        "properties": {
          "front": {
            "type": "string"
          },
          "back": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "chunk_id": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "session_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "summary": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
