{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QueryReplayIntent",
  "description": "Authoritative query replay-recovery contract persisted on the session row and seeded into the session_saved audit details for bounded recovery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "answer_basis",
    "writeback_plan"
  ],
  "properties": {
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "answer_basis": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "formal_wiki",
          "session_context",
          "learning_context",
          "raw_source_fallback"
        ]
      }
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "learning_proposal": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "learning_note_id",
        "student_id",
        "course_id",
        "class_id",
        "concepts",
        "gaps",
        "flashcards",
        "next_actions",
        "source_refs",
        "session_refs",
        "created_at"
      ],
      "properties": {
        "learning_note_id": {
          "type": "string"
        },
        "student_id": {
          "type": "string"
        },
        "course_id": {
          "type": "string"
        },
        "class_id": {
          "type": "string"
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flashcards": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "front",
              "back"
            ],
            "properties": {
              "front": {
                "type": "string"
              },
              "back": {
                "type": "string"
              }
            }
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "source_type"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "source_type": {
                "type": "string"
              },
              "chunk_id": {
                "type": "string"
              }
            }
          }
        },
        "session_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "candidate_proposal": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "kind",
        "status",
        "title",
        "summary",
        "class_id",
        "course_id",
        "confidence",
        "source_refs",
        "session_refs",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "misconception",
            "faq",
            "intervention",
            "unresolved_question",
            "operations_note"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "promoted",
            "merged",
            "dropped"
          ]
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "class_id": {
          "type": "string"
        },
        "course_id": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "source_type"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "source_type": {
                "type": "string"
              },
              "chunk_id": {
                "type": "string"
              }
            }
          }
        },
        "session_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "related_page_id": {
          "type": "string"
        }
      }
    },
    "writeback_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "action",
          "status",
          "target_id",
          "explanation"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "target_id": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    }
  }
}
