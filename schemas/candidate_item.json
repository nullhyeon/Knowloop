{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidateItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "kind",
    "status",
    "title",
    "summary",
    "class_id",
    "course_id",
    "source_refs",
    "confidence",
    "created_at"
  ],
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "misconception",
        "faq",
        "intervention",
        "unresolved_question",
        "operations_note"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "promoted",
        "merged",
        "dropped"
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "class_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "actor_role": {
      "type": "string",
      "enum": [
        "student",
        "instructor",
        "operator",
        "validator",
        "system"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "chunk_id": {
            "type": "string"
          }
        }
      }
    },
    "session_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "merged_into": {
      "type": "string"
    },
    "related_page_id": {
      "type": "string"
    }
  }
}
