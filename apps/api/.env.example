# Knowloop API local development settings
KNOWLOOP_APP_ENV=development
KNOWLOOP_API_V1_PREFIX=/api/v1
KNOWLOOP_DATA_ROOT=../../data
KNOWLOOP_LLM_ENABLED=false
KNOWLOOP_OPENAI_MODEL=gpt-5.4
KNOWLOOP_OPENAI_REASONING_EFFORT=low
KNOWLOOP_OPENAI_TEXT_VERBOSITY=medium
KNOWLOOP_OPENAI_TIMEOUT_SECONDS=30
KNOWLOOP_OPENAI_MAX_OUTPUT_TOKENS=450
# Required only when KNOWLOOP_LLM_ENABLED=true:
# KNOWLOOP_OPENAI_API_KEY=

# Optional overrides when the default data-root-derived paths are not enough:
# KNOWLOOP_META_ROOT=../../data/meta
# KNOWLOOP_SESSIONS_DB_PATH=../../data/meta/sessions.db
# KNOWLOOP_AUDIT_DB_PATH=../../data/meta/audit.db
